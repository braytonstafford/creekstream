# Canonical public URL (SEO / OG). Keep apex as creekstream.live.
NEXT_PUBLIC_SITE_URL=https://creekstream.live

# Public live embeds only — leave empty for a black screen + social links (never invent IDs).
# Prefer X. Optional YouTube / Rumble are fallbacks when X is unset.
# Do not put Frigate or LAN URLs in NEXT_PUBLIC_* (they ship in the client bundle).
NEXT_PUBLIC_X_EMBED_URL=
NEXT_PUBLIC_YOUTUBE_LIVE_ID=
NEXT_PUBLIC_RUMBLE_EMBED_ID=

# Optional Google Search Console HTML tag verification content
NEXT_PUBLIC_GSC_VERIFICATION=
